  }

  renderSetupScreen() {
    const slotsContainer = document.getElementById('setup-slots');
    slotsContainer.innerHTML = '';

    for(let i=0; i<3; i++) {
      let cid = saveData.teamChars[i];
      if(cid) {
        let c = DB.CHARACTERS.find(x => x.id === cid);
        slotsContainer.appendChild(this.createSkinSlotCard(c, true, i));
      } else {
        let empty = document.createElement('div');
        empty.className = 'skin-slot';
        empty.innerHTML = `<span style="font-size:2rem; color:#555;">＋</span>`;
        slotsContainer.appendChild(empty);
      }
    }

    // インベントリ一覧描画
    const grid = document.getElementById('skin-inventory-grid');
    grid.innerHTML = '';

    const list = DB.CHARACTERS.filter(c => {
      if(!saveData.unlockedChars.includes(c.id)) return false;
      if(this.currentFilter !== 'ALL' && c.type !== this.currentFilter) return false;
      return true;
    });

    list.forEach(c => {
      const isEquipped = saveData.teamChars.includes(c.id);
      const card = document.createElement('div');
      card.className = `card-item ${c.rarity} ${isEquipped ? 'selected' : ''}`;
      card.innerHTML = `
        <div style="font-size: 1.8rem;">${c.icon}</div>
        <div style="font-size: 0.7rem; font-weight:bold;">${c.name}</div>
        <div style="font-size: 0.6rem; color:#aaa;">${c.type}</div>
      `;
      card.onclick = () => this.addSkinToTeam(c.id);
      grid.appendChild(card);
    });

    const syn = this.getCalculatedSynergy();
    document.getElementById('info-oni-name').innerText = syn.oniName;
    document.getElementById('info-synergy').innerText = syn.synergyDesc;
  }

  filterSkins(type) {
    this.currentFilter = type;
    this.renderSetupScreen();
  }

  addSkinToTeam(charId) {
    if(saveData.teamChars.includes(charId)) return;
    if(saveData.teamChars.length >= 3) {
      saveData.teamChars.shift(); // 先頭を押し出し
    }
    saveData.teamChars.push(charId);
    this.renderSetupScreen();
  }

  removeSkinFromTeam(index) {
    saveData.teamChars.splice(index, 1);
    this.renderSetupScreen();
  }

  saveTeamAndReturn() {
    if(saveData.teamChars.length === 0) saveData.teamChars = ['c1'];
    saveData.save();
    this.showScreen('home-screen');
  }

  // 3スキンの相性シナジー計算
  getCalculatedSynergy() {
    const chars = saveData.teamChars.map(id => DB.CHARACTERS.find(c => c.id === id)).filter(Boolean);
    if(chars.length === 0) return { oniType: 0, oniName: '青鬼', speedBonus: 0, duration: 10, synergyDesc: '標準型', typeText: '通常' };

    let speedCount = chars.filter(c => c.type === 'SPEED').length;
    let attackCount = chars.filter(c => c.type === 'ATTACK').length;
    let balanceCount = chars.filter(c => c.type === 'BALANCE').length;

    let oniType = DB.ONI_TYPES.NORMAL;
    let speedBonus = chars.length * 10;
    let duration = 12 + chars.length * 2;
    let typeText = "バランス型";
    let synergyDesc = "バランスの取れた標準的な組み合わせ。";

    if(speedCount >= 2) {
      oniType = DB.ONI_TYPES.FUWATTY;
      speedBonus += 50;
      typeText = "スピード特化";
      synergyDesc = "【フワッティー変身】超高速移動で敵を追い詰める！";
    } else if(attackCount >= 2) {
      oniType = DB.ONI_TYPES.DEMON;
      duration += 5;
      typeText = "アタッカー特化";
      synergyDesc = "【魔王鬼変身】変身時間が大幅延長！";
    } else if(balanceCount >= 2) {
      oniType = DB.ONI_TYPES.ICE;
      typeText = "氷結バランス";
      synergyDesc = "【氷鬼変身】周囲の人間を遅くして逃げ場を絶つ！";
    }

    const oniData = DB.ONI_DATA.find(o => o.type === oniType) || DB.ONI_DATA[0];

    return {
      oniType, oniName: oniData.name, speedBonus, duration, synergyDesc, typeText
    };
  }

  renderZukan() {
    const grid = document.getElementById('zukan-grid');
    grid.innerHTML = '';
    DB.ONI_DATA.forEach(o => {
      const item = document.createElement('div');
      item.className = `card-item ${o.rarity}`;
      item.style.width = "100%"; item.style.flexDirection = "row"; item.style.justifyContent = "space-between";
      item.innerHTML = `
        <div style="font-weight:bold; font-size:1rem; color:#e74c3c;">👹 ${o.name}</div>
        <div style="font-size:0.8rem; color:#ccc;">${o.desc}</div>
        <div style="font-size:0.75rem; color:#f1c40f;">${o.rarity}</div>
      `;
      grid.appendChild(item);
    });
  }

  exportSaveCode() {
    document.getElementById('save-code-input').value = JSON.stringify(saveData);
  }

  importSaveCode() {
    try {
      const val = document.getElementById('save-code-input').value;
      if(!val) return;
      const parsed = JSON.parse(val);
      Object.assign(saveData, parsed);
      saveData.save();
      alert("セーブデータをロードしました！");
      this.showScreen('home-screen');
    } catch(e) {
      alert("無効なコードです。");
    }
  }
}

let gameEngine, uiManager;
window.addEventListener('load', () => {
  uiManager = new UIManager();
  gameEngine = new GameEngine();

  document.getElementById('title-screen').addEventListener('click', () => {
    uiManager.showScreen('home-screen');
  });
});
</script>
</body>
</html>
