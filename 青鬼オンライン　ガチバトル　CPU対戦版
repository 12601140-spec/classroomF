// 本編互換セーブデータクラス
class SaveData {
  constructor() {
    this.playerName = "ゲスト";
    this.coins = 1000;
    this.orbs = 0;
    this.unlockedChars = ['c1', 'c2', 'c3', 'c4', 'c5', 'c6', 'c7', 'c10', 'c14'];
