}
const saveData = new SaveData();

// ユーティリティ
const Utils = {
  random: (min, max) => Math.random() * (max - min) + min,
  randomInt: (min, max) => Math.floor(Math.random() * (max - min)) + min,
  distance: (x1, y1, x2, y2) => Math.sqrt((x2-x1)**2 + (y2-y1)**2),
  checkCollision: (r1, r2) => (r1.x < r2.x + r2.w && r1.x + r1.w > r2.x && r1.y < r2.y + r2.h && r1.y + r1.h > r2.y)
};

const TILE = { EMPTY: 0, WALL: 1, FLOOR: 2 };

// マップ生成エンジン
class MapGenerator {
  static generate(cols, rows) {
    let grid = Array.from({ length: rows }, () => Array(cols).fill(TILE.WALL));
    let rooms = [];
    let leaves = [{ x: 1, y: 1, w: cols - 2, h: rows - 2 }];
    
    for (let i = 0; i < 4; i++) {
      let newLeaves = [];
      for (let leaf of leaves) {
        let splitH = Math.random() > 0.5;
        let max = (splitH ? leaf.h : leaf.w) - 8;
        if (max <= 5) { newLeaves.push(leaf); continue; }
        let split = Utils.randomInt(5, max);
        if (splitH) {
          newLeaves.push({ x: leaf.x, y: leaf.y, w: leaf.w, h: split });
          newLeaves.push({ x: leaf.x, y: leaf.y + split, w: leaf.w, h: leaf.h - split });
        } else {
          newLeaves.push({ x: leaf.x, y: leaf.y, w: split, h: leaf.h });
          newLeaves.push({ x: leaf.x + split, y: leaf.y, w: leaf.w - split, h: leaf.h });
        }
      }
      leaves = newLeaves;
    }

    for (let leaf of leaves) {
      let rw = Utils.randomInt(4, leaf.w - 1);
      let rh = Utils.randomInt(4, leaf.h - 1);
      let rx = leaf.x + Utils.randomInt(1, leaf.w - rw);
      let ry = leaf.y + Utils.randomInt(1, leaf.h - rh);
      rooms.push({ x: rx, y: ry, w: rw, h: rh });
      for (let y = ry; y < ry + rh; y++) {
        for (let x = rx; x < rx + rw; x++) grid[y][x] = TILE.FLOOR;
      }
    }

    for (let i = 0; i < rooms.length - 1; i++) {
      let rA = rooms[i], rB = rooms[i + 1];
      let cxA = Math.floor(rA.x + rA.w/2), cyA = Math.floor(rA.y + rA.h/2);
      let cxB = Math.floor(rB.x + rB.w/2), cyB = Math.floor(rB.y + rB.h/2);
      for(let x = Math.min(cxA, cxB); x <= Math.max(cxA, cxB); x++) { grid[cyA][x] = TILE.FLOOR; }
      for(let y = Math.min(cyA, cyB); y <= Math.max(cyA, cyB); y++) { grid[y][cxB] = TILE.FLOOR; }
    }
    return grid;
  }

  static getRandomFloor(grid, cols, rows) {
    let max = 1000;
    while (max-- > 0) {
      let x = Utils.randomInt(1, cols - 1);
      let y = Utils.randomInt(1, rows - 1);
      if (grid[y][x] === TILE.FLOOR) return { x: x * CONFIG.TILE_SIZE, y: y * CONFIG.TILE_SIZE };
    }
    return { x: 3 * CONFIG.TILE_SIZE, y: 3 * CONFIG.TILE_SIZE };
  }
}

// キャラクター基底クラス（本編の描画と移動ルールを踏襲）
class Entity {
  constructor(x, y, w, h) { this.x = x; this.y = y; this.w = w; this.h = h; this.isDead = false; }
  getRect() { return { x: this.x, y: this.y, w: this.w, h: this.h }; }
}

class Character extends Entity {
  constructor(x, y, color, speed, icon, name) {
    super(x, y, 24, 24);
    this.color = color;
    this.speed = speed;
    this.icon = icon;
    this.name = name;
    this.dir = 0;
    this.isMoving = false;
    this.anim = 0;
    this.isOni = false;
    this.oniType = DB.ONI_TYPES.NORMAL;
    this.oniTimer = 0;
  }

  update(dt, game) {
    if(this.isDead) return;
    if(this.isMoving) this.anim += dt * 10;
    else this.anim = 0;

    if(this.isOni) {
      this.oniTimer -= dt;
      if(this.oniTimer <= 0) {
        this.isOni = false;
      }
    }
  }

  move(dx, dy, grid, cols, rows, dt) {
    if(this.isDead) return;
    if (dx === 0 && dy === 0) { this.isMoving = false; return; }

    this.isMoving = true;
    if(Math.abs(dx) > Math.abs(dy)) this.dir = dx > 0 ? 2 : 1;
    else this.dir = dy > 0 ? 0 : 3;

    let len = Math.sqrt(dx*dx + dy*dy);
    if(len === 0) return;

    let spd = this.isOni ? this.speed * 1.35 : this.speed;
    let vx = (dx/len) * spd * dt;
    let vy = (dy/len) * spd * dt;

    this.x += vx;
    if(this.checkWall(grid, cols, rows)) this.x -= vx;
    this.y += vy;
    if(this.checkWall(grid, cols, rows)) this.y -= vy;
  }

  checkWall(grid, cols, rows) {
    if(this.isOni && this.oniType === DB.ONI_TYPES.GHOST) return false; // 亡霊鬼は壁通過
    let left = Math.floor(this.x / CONFIG.TILE_SIZE), right = Math.floor((this.x + this.w) / CONFIG.TILE_SIZE);
    let top = Math.floor(this.y / CONFIG.TILE_SIZE), bottom = Math.floor((this.y + this.h) / CONFIG.TILE_SIZE);
    if(left<0 || right>=cols || top<0 || bottom>=rows) return true;
    return grid[top][left]===TILE.WALL || grid[top][right]===TILE.WALL || grid[bottom][left]===TILE.WALL || grid[bottom][right]===TILE.WALL;
  }

  transformToOni(oniType, duration) {
    this.isOni = true;
    this.oniType = oniType;
    this.oniTimer = duration;
  }

  draw(ctx) {
    if(this.isDead) return;

    if(this.isOni) {
      // 本編のEnemyOni描画ロジックをそのまま使用
      EnemyOniDraw.drawCustomOni(ctx, this.x, this.y, this.w, this.h, this.oniType, this.anim, this.dir);
      ctx.fillStyle = "#f1c40f"; ctx.font = "bold 11px sans-serif";
      ctx.fillText(`👹 ${this.name}`, this.x - 10, this.y - 45);
      return;
    }

    // 通常の人間描画（本編同様）
    let bob = this.isMoving ? Math.sin(this.anim)*3 : 0;
    let cx = this.x - 8, cy = this.y - 24;

    ctx.fillStyle = "rgba(0,0,0,0.3)";
    ctx.beginPath(); ctx.ellipse(this.x+this.w/2, this.y+this.h, 12, 4, 0, 0, Math.PI*2); ctx.fill();

    ctx.fillStyle = this.color;
    ctx.fillRect(cx+8, cy+16+bob, 24, 24);
    ctx.fillStyle = "#FFDCB6";
    ctx.fillRect(cx+6, cy+bob, 28, 20);
    
    ctx.fillStyle = "#000";
    if(this.dir===0 || this.dir===2) ctx.fillRect(cx+18, cy+8+bob, 4, 4);
    if(this.dir===0 || this.dir===1) ctx.fillRect(cx+10, cy+8+bob, 4, 4);

    ctx.font = "18px Arial";
    ctx.fillText(this.icon, this.x - 4, this.y - 30 + bob);
    ctx.fillStyle = "#fff"; ctx.font = "10px sans-serif";
    ctx.fillText(this.name, this.x - 8, this.y - 48);
  }
}

// 本編より完全移植：全タイプ対応の青鬼描画関数群
class EnemyOniDraw {
  static drawCustomOni(ctx, x, y, w, h, type, anim, dir) {
    let cx = x - (w==48?4:12), cy = y - (h==48?60:40);
    let bob = Math.sin(anim)*5;
    
    ctx.save();
    ctx.fillStyle = "rgba(0,0,0,0.5)"; ctx.beginPath(); ctx.ellipse(x+w/2, y+h, w/2, h/4, 0, 0, Math.PI*2); ctx.fill();

    let baseColor = '#8e44ad', headW = 56, headH = 40, bodyW = 40, bodyH = 42;
    let scale = (type === DB.ONI_TYPES.GIANT) ? 1.4 : 1;
    if(type === DB.ONI_TYPES.GIANT) { cx -= 10; cy -= 15; headW*=scale; headH*=scale; bodyW*=scale; bodyH*=scale; }
    
    switch(type) {
      case DB.ONI_TYPES.FUWATTY: baseColor = '#e74c3c'; break;
      case DB.ONI_TYPES.SQUAT: baseColor = '#27ae60'; break;
      case DB.ONI_TYPES.JELLY: baseColor = 'rgba(52, 152, 219, 0.8)'; break;
      case DB.ONI_TYPES.DEMON: baseColor = '#c0392b'; break;
      case DB.ONI_TYPES.ICE: baseColor = '#00ced1'; break;
      case DB.ONI_TYPES.FIRE: baseColor = '#ff4500'; break;
      case DB.ONI_TYPES.SLIME: baseColor = 'rgba(46, 204, 113, 0.8)'; break;
      case DB.ONI_TYPES.SPIDER: baseColor = '#2c3e50'; break;
      case DB.ONI_TYPES.NINJA: baseColor = '#1a252f'; break;
      case DB.ONI_TYPES.GHOST: baseColor = 'rgba(236, 240, 241, 0.6)'; break;
      case DB.ONI_TYPES.BOMB: baseColor = '#111'; break;
      case DB.ONI_TYPES.METAL: 
        let grad = ctx.createLinearGradient(cx, cy, cx+headW, cy+headH);
        grad.addColorStop(0, "#f1c40f"); grad.addColorStop(0.5, "#fff"); grad.addColorStop(1, "#d35400");
        baseColor = grad; break;
    }

    ctx.fillStyle = baseColor;
    if(type === DB.ONI_TYPES.SLIME || type === DB.ONI_TYPES.JELLY) {
      ctx.beginPath(); ctx.ellipse(cx+headW/2, cy+bob+bodyH/2, headW/2, bodyH/1.5, 0, 0, Math.PI*2); ctx.fill();
    } else {
      if(type !== DB.ONI_TYPES.GHOST) ctx.fillRect(cx+(headW-bodyW)/2, cy+30*scale+bob, bodyW, bodyH); 
      ctx.fillRect(cx, cy+bob, headW, headH); 
    }

    // 角や装飾
    if(type === DB.ONI_TYPES.DEMON) { 
      ctx.fillStyle="#000"; 
      ctx.beginPath(); ctx.moveTo(cx+10, cy+bob); ctx.lineTo(cx+20, cy-20+bob); ctx.lineTo(cx+30, cy+bob); ctx.fill();
      ctx.beginPath(); ctx.moveTo(cx+headW-10, cy+bob); ctx.lineTo(cx+headW-20, cy-20+bob); ctx.lineTo(cx+headW-30, cy+bob); ctx.fill();
    }

    // 目と口
    ctx.fillStyle = (type===DB.ONI_TYPES.METAL || type===DB.ONI_TYPES.DEMON) ? "#e74c3c" : "#fff";
    let eSize = 12 * scale;
    ctx.fillRect(cx+10*scale, cy+15*scale+bob, eSize, eSize); ctx.fillRect(cx+34*scale, cy+15*scale+bob, eSize, eSize);
    ctx.fillStyle = "#000";
    let eOff = dir===1 ? -4*scale : (dir===2 ? 4*scale : 0);
    ctx.fillRect(cx+14*scale+eOff, cy+18*scale+bob, 4*scale, 4*scale); ctx.fillRect(cx+38*scale+eOff, cy+18*scale+bob, 4*scale, 4*scale);
    ctx.fillRect(cx+18*scale, cy+32*scale+bob, 20*scale, 6*scale);
    ctx.restore();
  }
}

// ウィルスボックス
class VirusBox extends Entity {
  constructor(x, y) {
    super(x, y, 32, 32);
    this.anim = 0;
  }
  update(dt) { this.anim += dt * 3; }
  draw(ctx) {
    if(this.isDead) return;
    let floatY = Math.sin(this.anim) * 4;
    ctx.fillStyle = "#9b59b6";
    ctx.fillRect(this.x+2, this.y+2+floatY, 28, 28);
    ctx.strokeStyle = "#8e44ad"; ctx.lineWidth = 3;
    ctx.strokeRect(this.x+2, this.y+2+floatY, 28, 28);
    ctx.fillStyle = "#00ffcc"; ctx.font = "bold 16px sans-serif";
    ctx.fillText("🧪", this.x+6, this.y+22+floatY);
  }
}

// NPC AI
class NPC extends Character {
  constructor(x, y) {
    let skin = DB.CHARACTERS[Utils.randomInt(0, DB.CHARACTERS.length)];
    super(x, y, skin.color, skin.speedBase, skin.icon, DB.NPC_NAMES[Utils.randomInt(0, DB.NPC_NAMES.length)]);
    this.targetX = x; this.targetY = y;
    this.thinkTimer = 0;
  }

  update(dt, game) {
    super.update(dt, game);
    if(this.isDead) return;

    this.thinkTimer -= dt;
    if(this.isOni) {
      // 鬼の時は一番近い人間を追跡
      let nearestTarget = null, minDist = 9999;
      const candidates = [game.player, ...game.npcs].filter(c => c !== this && !c.isDead && !c.isOni);
      for(let c of candidates) {
        let d = Utils.distance(this.x, this.y, c.x, c.y);
        if(d < minDist) { minDist = d; nearestTarget = c; }
      }
      if(nearestTarget) {
        let dx = nearestTarget.x - this.x, dy = nearestTarget.y - this.y;
        this.move(dx, dy, game.grid, game.cols, game.rows, dt);
      }
    } else {
      // 人間の時は近くの鬼から逃げる / またはウィルスボックスを目指す
      let nearestOni = null, oniDist = 400;
      const onis = [game.player, ...game.npcs].filter(c => c !== this && !c.isDead && c.isOni);
      for(let o of onis) {
        let d = Utils.distance(this.x, this.y, o.x, o.y);
        if(d < oniDist) { oniDist = d; nearestOni = o; }
      }

      if(nearestOni) {
        let dx = this.x - nearestOni.x, dy = this.y - nearestOni.y;
        this.move(dx, dy, game.grid, game.cols, game.rows, dt);
      } else {
        // ウイルスボックス探しまたはランダム徘徊
        if(this.thinkTimer <= 0) {
          this.thinkTimer = Utils.random(2, 4);
          let box = game.virusBoxes.find(b => !b.isDead);
          if(box && Math.random() > 0.4) {
            this.targetX = box.x; this.targetY = box.y;
          } else {
            this.targetX = this.x + Utils.random(-200, 200);
            this.targetY = this.y + Utils.random(-200, 200);
          }
        }
        let dx = this.targetX - this.x, dy = this.targetY - this.y;
        if(Math.abs(dx) > 10 || Math.abs(dy) > 10) this.move(dx, dy, game.grid, game.cols, game.rows, dt);
      }
    }
  }
}

// ゲーム管理メインエンジン
class GameEngine {
  constructor() {
    this.canvas = document.getElementById('game-canvas');
    this.ctx = this.canvas.getContext('2d');
    this.grid = [];
    this.cols = CONFIG.COLS; this.rows = CONFIG.ROWS;
    this.player = null;
    this.npcs = [];
    this.virusBoxes = [];
    this.aliveCount = CONFIG.TOTAL_PLAYERS;
    this.kills = 0;
    this.isPlaying = false;
    this.lastTime = 0;
    this.joy = { x: 0, y: 0, active: false };
    this.keys = {};
    this.camera = { x: 0, y: 0 };

    this.initControls();
    this.resize();
    window.addEventListener('resize', () => this.resize());
    requestAnimationFrame((t) => this.loop(t));
  }

  resize() {
    this.canvas.width = window.innerWidth;
    this.canvas.height = window.innerHeight;
  }

  initControls() {
    window.addEventListener('keydown', e => this.keys[e.code] = true);
    window.addEventListener('keyup', e => this.keys[e.code] = false);

    const zone = document.getElementById('joystick-zone');
    const knob = document.getElementById('joystick-knob');
    const handleTouch = (e) => {
      e.preventDefault();
      if(!e.targetTouches[0]) { this.joy.active = false; knob.style.transform=`translate(-50%,-50%)`; return; }
      let rect = zone.getBoundingClientRect(), r = rect.width/2;
      let dx = e.targetTouches[0].clientX - (rect.left+r);
      let dy = e.targetTouches[0].clientY - (rect.top+r);
      let dist = Math.sqrt(dx*dx+dy*dy);
      if(dist > r) { dx = (dx/dist)*r; dy = (dy/dist)*r; }
      knob.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px))`;
      this.joy.x = dx/r; this.joy.y = dy/r; this.joy.active = true;
    };
    zone.addEventListener('touchstart', handleTouch);
    zone.addEventListener('touchmove', handleTouch);
    zone.addEventListener('touchend', () => { this.joy.active = false; this.joy.x = 0; this.joy.y = 0; knob.style.transform=`translate(-50%,-50%)`; });
  }

  startMatch() {
    this.grid = MapGenerator.generate(this.cols, this.rows);
    this.npcs = [];
    this.virusBoxes = [];
    this.kills = 0;
    this.aliveCount = CONFIG.TOTAL_PLAYERS;

    // スキン3体構成から能力と変身タイプを算出
    const synergy = uiManager.getCalculatedSynergy();

    let pPos = MapGenerator.getRandomFloor(this.grid, this.cols, this.rows);
    const mainChar = DB.CHARACTERS.find(c => c.id === saveData.teamChars[0]) || DB.CHARACTERS[0];
    
    this.player = new Character(pPos.x, pPos.y, mainChar.color, mainChar.speedBase + synergy.speedBonus, mainChar.icon, saveData.playerName);
    this.player.transformedOniType = synergy.oniType;
    this.player.oniDuration = synergy.duration;

    // NPC 99体配置
    for(let i=0; i<CONFIG.TOTAL_PLAYERS-1; i++) {
      let pos = MapGenerator.getRandomFloor(this.grid, this.cols, this.rows);
      let npc = new NPC(pos.x, pos.y);
      npc.transformedOniType = Utils.randomInt(0, 18);
      npc.oniDuration = 12;
      this.npcs.push(npc);
    }

    // 初期ウィルスボックス発生
    for(let i=0; i<CONFIG.VIRUS_BOX_COUNT; i++) this.spawnVirusBox();

    this.isPlaying = true;
    uiManager.showScreen('hud');
    document.getElementById('hud').classList.remove('hidden');
    this.addKillLog("ガチバトルが開始されました！");
  }

  spawnVirusBox() {
    let pos = MapGenerator.getRandomFloor(this.grid, this.cols, this.rows);
    this.virusBoxes.push(new VirusBox(pos.x, pos.y));
  }

  loop(timestamp) {
    let dt = (timestamp - this.lastTime) / 1000;
    if(isNaN(dt) || dt > 0.1) dt = 0.016;
    this.lastTime = timestamp;

    if(this.isPlaying) {
      this.update(dt);
      this.draw();
    }

    requestAnimationFrame((t) => this.loop(t));
  }

  update(dt) {
    // プレイヤー操作
    let dx = 0, dy = 0;
    if(this.keys['KeyW'] || this.keys['ArrowUp']) dy -= 1;
    if(this.keys['KeyS'] || this.keys['ArrowDown']) dy += 1;
    if(this.keys['KeyA'] || this.keys['ArrowLeft']) dx -= 1;
    if(this.keys['KeyD'] || this.keys['ArrowRight']) dx += 1;
    if(this.joy.active) { dx = this.joy.x; dy = this.joy.y; }

    this.player.update(dt, this);
    this.player.move(dx, dy, this.grid, this.cols, this.rows, dt);

    // カメラ更新
    this.camera.x = this.player.x - this.canvas.width / 2;
    this.camera.y = this.player.y - this.canvas.height / 2;

    // NPC更新
    for(let npc of this.npcs) npc.update(dt, this);

    // ウィルスボックス更新・取得判定
    for(let box of this.virusBoxes) {
      if(box.isDead) continue;
      box.update(dt);

      const allChars = [this.player, ...this.npcs].filter(c => !c.isDead);
      for(let c of allChars) {
        if(Utils.checkCollision(c.getRect(), box.getRect())) {
          box.isDead = true;
          c.transformToOni(c.transformedOniType, c.oniDuration);
          this.addKillLog(`${c.name}が【ウィルス】で青鬼に変身！`);
          setTimeout(() => this.spawnVirusBox(), 10000);
          break;
        }
      }
    }

    // 鬼による捕食判定（ガチバトル核心）
    const activeChars = [this.player, ...this.npcs].filter(c => !c.isDead);
    for(let attacker of activeChars) {
      if(!attacker.isOni) continue;
      for(let victim of activeChars) {
        if(victim.isDead || victim === attacker || victim.isOni) continue;

        if(Utils.checkCollision(attacker.getRect(), victim.getRect())) {
          victim.isDead = true;
          this.aliveCount--;
          if(attacker === this.player) this.kills++;
          this.addKillLog(`👹 ${attacker.name} が ${victim.name} を撃破！`);

          if(victim === this.player) {
            this.endGame(false);
            return;
          }

          if(this.aliveCount <= 1) {
            this.endGame(true);
            return;
          }
        }
      }
    }

    // UI更新
    document.getElementById('alive-count').innerText = this.aliveCount;
    const oniPanel = document.getElementById('oni-timer-panel');
    if(this.player.isOni) {
      oniPanel.classList.remove('hidden');
      document.getElementById('oni-timer').innerText = Math.ceil(this.player.oniTimer);
    } else {
      oniPanel.classList.add('hidden');
    }
  }

  endGame(isVictory) {
    this.isPlaying = false;
    document.getElementById('hud').classList.add('hidden');
    
    let rank = isVictory ? 1 : this.aliveCount;
    let earnedCoins = (101 - rank) * 15 + this.kills * 50;
    saveData.coins += earnedCoins;
    saveData.save();

    document.getElementById('result-rank-title').innerText = isVictory ? "🏆 青逃(勝利)！" : `${rank}位 / 100人`;
    document.getElementById('result-detail').innerText = `撃破数(キル): ${this.kills}体`;
    document.getElementById('result-coin-amount').innerText = earnedCoins;

    uiManager.showScreen('result-screen');
  }

  addKillLog(msg) {
    const logContainer = document.getElementById('kill-log');
    const entry = document.createElement('div');
    entry.className = 'log-entry';
    entry.innerText = msg;
    logContainer.appendChild(entry);
    if(logContainer.children.length > 5) logContainer.removeChild(logContainer.children[0]);
    setTimeout(() => { if(entry.parentNode) entry.parentNode.removeChild(entry); }, 4000);
  }

  draw() {
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
    this.ctx.save();
    this.ctx.translate(-this.camera.x, -this.camera.y);

    // マップ描画
    let startCol = Math.max(0, Math.floor(this.camera.x / CONFIG.TILE_SIZE));
    let endCol = Math.min(this.cols, startCol + Math.ceil(this.canvas.width / CONFIG.TILE_SIZE) + 1);
    let startRow = Math.max(0, Math.floor(this.camera.y / CONFIG.TILE_SIZE));
    let endRow = Math.min(this.rows, startRow + Math.ceil(this.canvas.height / CONFIG.TILE_SIZE) + 1);

    for(let r = startRow; r < endRow; r++) {
      for(let c = startCol; c < endCol; c++) {
        let x = c * CONFIG.TILE_SIZE, y = r * CONFIG.TILE_SIZE;
        if(this.grid[r][c] === TILE.WALL) {
          this.ctx.fillStyle = "#1e2b37";
          this.ctx.fillRect(x, y, CONFIG.TILE_SIZE, CONFIG.TILE_SIZE);
          this.ctx.strokeStyle = "#0f171e";
          this.ctx.strokeRect(x, y, CONFIG.TILE_SIZE, CONFIG.TILE_SIZE);
        } else {
          this.ctx.fillStyle = "#2c3e50";
          this.ctx.fillRect(x, y, CONFIG.TILE_SIZE, CONFIG.TILE_SIZE);
        }
      }
    }

    // ウィルスボックス描画
    for(let box of this.virusBoxes) box.draw(this.ctx);

    // NPC・プレイヤー描画
    for(let npc of this.npcs) npc.draw(this.ctx);
    this.player.draw(this.ctx);

    this.ctx.restore();
  }
}

// UI＆編成マネージャー
